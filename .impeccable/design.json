 "narrative": {
  "northStar": "The Loaded Bar",
  "overview": "A working kitchen-and-store tool dressed in competition bumper plates. Plate blue owns the shell; red, yellow and green are the plates, and they only ever mean protein, carbs and fat. Numbers are set like plate lettering. The food photos carry the browse experience.",
  "keyCharacteristics": [
   "Plate-blue shell, chalk ground (light) or rubber graphite (dark).",
   "Macro colours are data, never decoration.",
   "Condensed uppercase for titles and section heads; Barlow for everything you read.",
   "Big targets: 44px minimum, 60px shopping rows, 72px cook-mode buttons.",
   "Flat surfaces with hairline rules; shadows only on things floating over photos or the page."
  ],
  "rules": [
   {
    "name": "The Plates Mean Macros Rule",
    "body": "Red, yellow and green appear only where they encode protein, carbs or fat (plus red on the favourite heart).",
    "section": "colors"
   },
   {
    "name": "The Blue Shell Rule",
    "body": "The shell is always Plate Blue, except full-screen cook mode.",
    "section": "colors"
   },
   {
    "name": "The Lettering Rule",
    "body": "Any number a user decides with is set in Barlow Condensed with tabular numerals.",
    "section": "typography"
   }
  ],
  "dos": [
   "Do put protein first and in Protein Red Ink wherever macros are summarised.",
   "Do keep every tap target at least 44px; shopping rows at least 60px.",
   "Do use the authored icon set in web/src/components/Icon.tsx.",
   "Do let recipe photos run edge to edge on phone and keep text off them.",
   "Do respect prefers-reduced-motion and both colour schemes via the tokens."
  ],
  "donts": [
   "Don't use red, yellow or green for anything other than protein, carbs and fat (and the favourite heart).",
   "Don't put macro numbers in the body face or proportional numerals.",
   "Don't add drop shadows to flat panels or cards; depth is tonal.",
   "Don't load fonts or scripts from a CDN; the app runs offline on the tailnet."
  ]
 }
