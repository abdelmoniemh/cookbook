# systemd user unit for the cookbook server.
# Install: see deploy/README.md (assumes the repo is cloned to ~/cookbook and `uv sync` has been run).
[Unit]
Description=Cookbook (recipes, meal plans, shopping lists)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/cookbook
Environment=PYTHONUNBUFFERED=1
Environment=COOKBOOK_DATA_DIR=%h/.local/share/cookbook
# Runs the console script from the uv-managed venv directly, so uv is not needed at runtime.
# Alternative: ExecStart=/usr/bin/uv run --frozen cookbook-serve --host 0.0.0.0 --port 8000
ExecStart=%h/cookbook/.venv/bin/cookbook-serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
